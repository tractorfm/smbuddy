---
import BaseLayout from "./BaseLayout.astro";
import NavBar from "../components/NavBar.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<BaseLayout title={`${title} – SMBuddy`}>
  <NavBar />
  <main>
    <section class="section legal-section">
      <div class="container">
        <div class="legal-content">
          <slot />
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .legal-section {
    padding-top: calc(80px + var(--space-2xl));
  }

  .legal-content {
    max-width: 720px;
    margin: 0 auto;
  }

  .legal-content :global(h1) {
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    margin-bottom: var(--space-sm);
  }

  .legal-content :global(h2) {
    font-size: 1.25rem;
    margin-top: var(--space-2xl);
    margin-bottom: var(--space-md);
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid var(--border);
  }

  .legal-content :global(h3) {
    font-size: 1.05rem;
    margin-top: var(--space-lg);
    margin-bottom: var(--space-sm);
  }

  .legal-content :global(p) {
    color: var(--text-secondary);
    font-size: 0.925rem;
    line-height: 1.75;
    margin-bottom: var(--space-md);
    max-width: none;
  }

  .legal-content :global(strong) {
    color: var(--text-primary);
    font-weight: 600;
  }

  .legal-content :global(a) {
    color: var(--accent-blue);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .legal-content :global(a:hover) {
    color: var(--accent-teal);
  }

  .legal-content :global(ul),
  .legal-content :global(ol) {
    padding-left: 1.5em;
    margin-bottom: var(--space-md);
  }

  .legal-content :global(li) {
    color: var(--text-secondary);
    font-size: 0.925rem;
    line-height: 1.75;
    margin-bottom: var(--space-xs);
  }

  .legal-content :global(hr) {
    border: none;
    border-top: 1px solid var(--border);
    margin: var(--space-xl) 0;
  }
</style>
