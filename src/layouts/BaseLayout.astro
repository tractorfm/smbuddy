---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "SMBuddy – Subscription AI Integration for Small Business",
  description = "We help you adopt AI with practical tools – assistants, automations, dashboards. We are humans who build with AI for you, on a flat monthly subscription.",
} = Astro.props;

const gaMeasurementId = (import.meta.env.PUBLIC_GA_MEASUREMENT_ID ?? "").trim();
const hasGoogleAnalytics = /^G-[A-Z0-9]+$/i.test(gaMeasurementId);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://smbuddy.co" />
    <meta property="og:site_name" content="SMBuddy" />
    <meta property="og:image" content="https://smbuddy.co/og-cover.jpg?1" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:creator" content="@karulin" />
    <meta name="twitter:image" content="https://smbuddy.co/og-cover.jpg?1" />

    {
      hasGoogleAnalytics && (
        <script>
          window.dataLayer = window.dataLayer || [];
          window.gtag =
            window.gtag ||
            function gtag() {
              window.dataLayer.push(arguments);
            };
          window.gtag("consent", "default", {
            ad_storage: "denied",
            ad_user_data: "denied",
            ad_personalization: "denied",
            analytics_storage: "denied",
          });
        </script>
      )
    }

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@600;700;800;900&family=Inter:wght@400;500;600&family=Rubik:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />

    <style is:global>
      @import "../styles/global.css";
    </style>
  </head>
  <body>
    <slot />

    {
      hasGoogleAnalytics && (
        <script define:vars={{ gaMeasurementId }}>
          const COOKIE_CONSENT_STORAGE_KEY = "smbuddy_cookie_consent_v1";

          function ensureGoogleTag() {
            window.dataLayer = window.dataLayer || [];
            window.gtag =
              window.gtag ||
              function gtag() {
                window.dataLayer.push(arguments);
              };
          }

          function updateGoogleAnalyticsConsent(granted) {
            ensureGoogleTag();
            window.gtag("consent", "update", {
              analytics_storage: granted ? "granted" : "denied",
              ad_storage: "denied",
              ad_user_data: "denied",
              ad_personalization: "denied",
            });
          }

          function loadGoogleAnalytics() {
            if (document.querySelector(`script[data-smbuddy-ga="${gaMeasurementId}"]`)) return;
            window.gtag("js", new Date());
            window.gtag("config", gaMeasurementId);

            const script = document.createElement("script");
            script.async = true;
            script.dataset.smbuddyGa = gaMeasurementId;
            script.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(gaMeasurementId)}`;
            document.head.appendChild(script);
          }

          function storedCookieConsent() {
            try {
              const value = window.localStorage.getItem(COOKIE_CONSENT_STORAGE_KEY);
              return value === "accepted" || value === "declined" ? value : null;
            } catch {
              return null;
            }
          }

          function storeCookieConsent(choice) {
            try {
              window.localStorage.setItem(COOKIE_CONSENT_STORAGE_KEY, choice);
            } catch {
              // If storage is unavailable, keep the runtime choice for this page load only.
            }
          }

          function installCookieConsent() {
            document.querySelectorAll("[data-cookie-settings]").forEach((trigger) => {
              trigger.hidden = false;
              trigger.addEventListener("click", () => {
                showCookieConsentBanner(true);
              });
            });

            const existing = storedCookieConsent();
            if (existing === "accepted") {
              updateGoogleAnalyticsConsent(true);
              loadGoogleAnalytics();
              return;
            }
            if (existing === "declined") {
              updateGoogleAnalyticsConsent(false);
              return;
            }

            showCookieConsentBanner(false);
          }

          function showCookieConsentBanner(manageExisting) {
            document.querySelector(".cookie-consent")?.remove();

            const banner = document.createElement("section");
            banner.className = "cookie-consent";
            banner.setAttribute("aria-label", "Cookie consent");
            banner.innerHTML = `
              <div class="cookie-consent__copy">
                <strong>${manageExisting ? "Cookie settings" : "Analytics cookies?"}</strong>
                <span>We use Google Analytics only if you allow it, to understand which pages help people evaluate SMBuddy. No ads cookies are enabled.</span>
              </div>
              <div class="cookie-consent__actions">
                <button class="cookie-consent__button cookie-consent__button--ghost" type="button" data-cookie-consent="declined">Decline</button>
                <button class="cookie-consent__button cookie-consent__button--primary" type="button" data-cookie-consent="accepted">Allow</button>
              </div>
            `;

            banner.addEventListener("click", (event) => {
              const target = event.target instanceof HTMLElement
                ? event.target.closest("[data-cookie-consent]")
                : null;
              if (!target) return;
              const choice = target.dataset.cookieConsent === "accepted" ? "accepted" : "declined";
              storeCookieConsent(choice);
              updateGoogleAnalyticsConsent(choice === "accepted");
              if (choice === "accepted") {
                loadGoogleAnalytics();
              }
              banner.remove();
            });

            document.body.appendChild(banner);
          }

          installCookieConsent();
        </script>
      )
    }

    <script>
      // Scroll-triggered reveal animations
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: "0px 0px -40px 0px" }
      );

      document.querySelectorAll("[data-animate]").forEach((el) => {
        observer.observe(el);
      });
    </script>
  </body>
</html>
