---
const features = [
  "Unlimited requests in your queue",
  "One active request at a time",
  "Async-first via Trello board",
  "25 min monthly sync call (optional)",
  "First meaningful result within 24-48h",
  "Pause anytime (conditions apply)",
  "Your stack, your data, full ownership",
];
---

<section class="section pricing-section" id="pricing">
  <div class="pricing-glow" aria-hidden="true"></div>
  <div class="container">
    <div class="section-header" data-animate>
      <span class="eyebrow">Simple Pricing</span>
      <h2>One plan. Everything included.</h2>
    </div>

    <div class="pricing-card-wrapper" data-animate style="--stagger: 1">
      <div class="pricing-card">
        <div class="pricing-badge">Limited-time offer</div>

        <div class="pricing-amount">
          <span class="price-old">$7,500</span>
          <span class="price-current">$6,000</span>
          <span class="price-period">/month</span>
        </div>
        <p class="price-note">VAT not included</p>

        <div class="pricing-divider"></div>

        <ul class="pricing-features">
          {
            features.map((f) => (
              <li>
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <polyline points="20 6 9 17 4 12" />
                </svg>
                <span>{f}</span>
              </li>
            ))
          }
        </ul>

        <a href="#booking" class="btn btn-primary btn-full">Book intro call</a>

        <p class="pricing-fine">Cancel or pause anytime. No contracts.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .pricing-section {
    position: relative;
    overflow: hidden;
  }

  .pricing-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 700px;
    height: 500px;
    background: radial-gradient(
      ellipse at center,
      rgba(59, 130, 246, 0.1) 0%,
      rgba(59, 130, 246, 0.05) 40%,
      transparent 70%
    );
    filter: blur(80px);
    pointer-events: none;
  }

  .pricing-card-wrapper {
    max-width: 480px;
    margin: 0 auto;
    padding: 2px;
    border-radius: calc(var(--radius-xl) + 2px);
    background: linear-gradient(135deg, var(--accent-blue), var(--accent-blue));
    position: relative;
  }

  .pricing-card {
    background: var(--bg-surface);
    border-radius: var(--radius-xl);
    padding: var(--space-2xl);
    text-align: center;
  }

  .pricing-badge {
    display: inline-block;
    padding: 5px 14px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--signal-orange);
    background: rgba(249, 115, 22, 0.1);
    border: 1px solid rgba(249, 115, 22, 0.25);
    border-radius: var(--radius-pill);
    margin-bottom: var(--space-lg);
  }

  .pricing-amount {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-xs);
  }

  .price-old {
    font-size: 1.2rem;
    color: var(--text-tertiary);
    text-decoration: line-through;
    font-weight: 500;
  }

  .price-current {
    font-family: "Inter Tight", sans-serif;
    font-weight: 900;
    font-size: clamp(2.5rem, 6vw, 3.5rem);
    color: var(--text-primary);
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .price-period {
    font-size: 1.1rem;
    color: var(--text-tertiary);
    font-weight: 500;
  }

  .price-note {
    font-size: 0.8rem;
    color: var(--text-tertiary);
    margin-bottom: var(--space-lg);
  }

  .pricing-divider {
    height: 1px;
    background: var(--border);
    margin-bottom: var(--space-lg);
  }

  .pricing-features {
    text-align: left;
    margin-bottom: var(--space-xl);
  }

  .pricing-features li {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-sm) 0;
    font-size: 0.95rem;
    color: var(--text-secondary);
  }

  .pricing-features svg {
    flex-shrink: 0;
    color: var(--accent-teal);
  }

  .btn-full {
    width: 100%;
    padding: 16px 32px;
    font-size: 1rem;
  }

  .pricing-fine {
    margin-top: var(--space-md);
    font-size: 0.8rem;
    color: var(--text-tertiary);
  }
</style>
