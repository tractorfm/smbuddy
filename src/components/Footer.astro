---

<footer class="footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <span class="footer-logo">SMBuddy</span>
      <p>Subscription AI integration for entrepreneurs.</p>
    </div>
    <div class="footer-links">
      <a href="https://x.com/karulin" target="_blank" rel="noopener">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
          <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
        </svg>
        @karulin
      </a>
      <a href="https://linkedin.com/in/borkasm/" target="_blank" rel="noopener">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
        </svg>
        @borkasm
      </a>
    </div>
    <div class="footer-legal">
      <a href="/privacy">Privacy Policy</a>
      <span class="dot" aria-hidden="true"></span>
      <a href="/terms">Terms of Service</a>
    </div>
    <p class="footer-copy">&copy; 2025 SMBuddy. All rights reserved.</p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    padding: var(--space-2xl) 0;
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
    text-align: center;
  }

  .footer-logo {
    font-family: "Rubik", sans-serif;
    font-weight: 800;
    font-size: 1.1rem;
    color: var(--text-primary);
    letter-spacing: -0.02em;
  }

  .footer-brand p {
    font-size: 0.85rem;
    color: var(--text-tertiary);
    margin-top: var(--space-xs);
  }

  .footer-links {
    display: flex;
    gap: var(--space-lg);
  }

  .footer-links a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.85rem;
    color: var(--text-tertiary);
    transition: color var(--duration-fast);
  }

  .footer-links a:hover {
    color: var(--text-primary);
  }

  .footer-legal {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-size: 0.8rem;
  }

  .footer-legal a {
    color: var(--text-tertiary);
    transition: color var(--duration-fast);
  }

  .footer-legal a:hover {
    color: var(--text-primary);
  }

  .footer-legal .dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--text-tertiary);
    opacity: 0.5;
  }

  .footer-copy {
    font-size: 0.75rem;
    color: var(--text-tertiary);
    opacity: 0.7;
  }
</style>
