---
---

<section class="section" id="booking">
  <div class="container">
    <div class="booking-header" data-animate>
      <span class="eyebrow">Get Started</span>
      <h2>Book your intro call.</h2>
      <p class="booking-desc">
        20-25 minutes to define your goals, map your current stack, and identify
        your first highest-ROI automation. No commitment. No pitch deck.
      </p>
    </div>

    <div class="booking-alt" data-animate style="--stagger: 1">
      <p>
        Prefer async?
        <a href="mailto:hey@smbuddy.co" class="contact-link">hey@smbuddy.co</a>
      </p>
    </div>

    <div class="booking-embed" data-animate style="--stagger: 2">
      <div id="cal-inline" class="cal-container"></div>
      <p class="cal-fallback">
        Can't see the calendar?
        <a
          href="https://cal.com/smbuddy/intro"
          target="_blank"
          rel="noopener"
        >
          Book directly on Cal.com
        </a>
      </p>
    </div>
  </div>
</section>

<script is:inline>
  (function (C, A, L) {
    let p = function (a, ar) {
      a.q.push(ar);
    };
    let d = C.document;
    C.Cal =
      C.Cal ||
      function () {
        let cal = C.Cal;
        let ar = arguments;
        if (!cal.loaded) {
          cal.ns = {};
          cal.q = cal.q || [];
          d.head.appendChild(d.createElement("script")).src = A;
          cal.loaded = true;
        }
        if (ar[0] === L) {
          const api = function () {
            p(api, arguments);
          };
          const namespace = ar[1];
          api.q = api.q || [];
          if (typeof namespace === "string") {
            cal.ns[namespace] = cal.ns[namespace] || api;
            p(cal.ns[namespace], ar);
            p(cal, ["initNamespace", namespace]);
          } else p(cal, ar);
          return;
        }
        p(cal, ar);
      };
  })(window, "https://app.cal.com/embed/embed.js", "init");

  Cal("init", "intro", { origin: "https://cal.com" });
  Cal.ns["intro"]("inline", {
    elementOrSelector: "#cal-inline",
    calLink: "smbuddy/intro",
    layout: "month_view",
    config: { theme: "dark" },
  });
  Cal.ns["intro"]("ui", {
    theme: "dark",
    hideEventTypeDetails: true,
    layout: "month_view",
  });
</script>

<style>
  .booking-header {
    text-align: center;
    margin-bottom: var(--space-2xl);
  }

  .booking-header h2 {
    margin-bottom: var(--space-md);
  }

  .booking-desc {
    max-width: 580px;
    margin: 0 auto;
    font-size: 1.05rem;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .booking-embed {
  }

  .cal-container {
    width: 100%;
    min-height: 480px;
    overflow: hidden;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
  }

  .cal-fallback {
    margin: var(--space-sm) auto 0;
    text-align: center;
    font-size: 0.8rem;
    color: var(--text-tertiary);
  }

  .cal-fallback a {
    color: var(--accent-purple);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .booking-alt {
    text-align: center;
    margin-bottom: var(--space-2xl);
  }

  .booking-alt p {
    margin: 0 auto;
    font-size: 0.9rem;
    color: var(--text-tertiary);
  }

  .contact-link {
    color: var(--accent-purple);
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color var(--duration-fast);
  }

  .contact-link:hover {
    color: var(--text-primary);
  }

  @media (max-width: 640px) {
    .cal-container {
      min-height: 560px;
    }
  }
</style>
